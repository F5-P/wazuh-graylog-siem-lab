<!-- Referência reconstruída do laboratório. Incorporar sem duplicar IDs. -->
<group name="windows,sysmon,lab_test,">
  <rule id="100100" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)notepad\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)powershell\.exe$</field>
    <description>LAB TEST: Notepad launched from PowerShell.</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>sysmon_process_creation,</group>
  </rule>

  <!-- Nível 8 preservado do exercício; depende da regra nativa 92057. -->
  <rule id="100101" level="8">
    <if_sid>92057</if_sid>
    <description>PowerShell executed with an encoded command.</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>powershell,encoded_command,</group>
  </rule>
</group>
